# === Root-level .gitignore for Ionic + Angular + Capacitor ===

# Angular & Ionic build artifacts
dist/
www/
.angular/
.angular/cache/

# Node dependencies
node_modules/

# Capacitor generated files
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# macOS & Windows system files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/

# Environment files
.env
